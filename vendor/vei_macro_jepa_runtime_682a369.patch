+        """Require state-conditioned consequence ordering.
+
+        Legacy callers retain the previous-root degradation margin. A
+        provenance-aware caller can instead supply multiple donor states,
+        donor-aligned targets, and meaningful disagreement masks; those losses
+        are averaged so loader order and a single donor cannot control an update.
+        """
+
+        if self.auxiliary_head is None or batch.observation_numeric.size(0) < 2:
+            return forward_pass.total_loss.new_zeros(())
