+def _packed_root_batch_identity(batch: StepBatch) -> tuple[str, tuple[str, ...]]:
+    roots = batch.metadata.get("root_id")
+    candidates = batch.metadata.get("candidate_id")
+    if roots is None or candidates is None or len(roots) != len(candidates):
+        raise ValueError(
+            "compatible-root state sensitivity requires root_id and candidate_id "
+            "batch metadata"
+        )
+    root_ids: list[str] = []
+    candidate_ids: list[str] = []
+    for root_sequence, candidate_sequence in zip(roots, candidates, strict=True):
+        if not root_sequence or len(set(root_sequence)) != 1:
+            raise ValueError("state-sensitivity batch root metadata is inconsistent")
+        if not candidate_sequence or len(set(candidate_sequence)) != 1:
+            raise ValueError(
+                "state-sensitivity batch candidate metadata is inconsistent"
+            )
+        root_ids.append(root_sequence[0])
+        candidate_ids.append(candidate_sequence[0])
+    if len(set(root_ids)) != 1:
+        raise ValueError("state-sensitivity batches must contain exactly one root")
+    if len(set(candidate_ids)) != len(candidate_ids):
+        raise ValueError("state-sensitivity root contains duplicate candidates")
+    return root_ids[0], tuple(candidate_ids)
+
