+        auxiliary_numeric_targets=batch.auxiliary_numeric_targets,
+        valid_mask=batch.valid_mask,
+        metadata=batch.metadata,
+        choice_loss_mask=batch.choice_loss_mask,
+        transition_loss_mask=batch.transition_loss_mask,
+        post_state_observed=batch.post_state_observed,
+        auxiliary_numeric_target_masks=batch.auxiliary_numeric_target_masks,
+    )
