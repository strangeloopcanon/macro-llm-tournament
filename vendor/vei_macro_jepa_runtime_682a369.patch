+def _zero_observation_batch(batch: StepBatch) -> StepBatch:
+    """Keep the identical architecture while removing all state information."""
+
+    return StepBatch(
+        observation_numeric=torch.zeros_like(batch.observation_numeric),
+        observation_masks=torch.zeros_like(batch.observation_masks),
