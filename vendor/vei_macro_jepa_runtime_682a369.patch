+def _masked_auxiliary_prediction_loss(
+    model: StructuredStateJEPA,
+    batch: StepBatch,
+    *,
+    forward_pass: object,
+    excluded_lineage_prefixes: Mapping[int, tuple[str, ...]],
+) -> torch.Tensor:
+    if model.auxiliary_head is None:
+        return batch.observation_numeric.new_zeros(())
+    predicted = getattr(forward_pass, "predicted_latents")
+    estimates = model.auxiliary_head(predicted)
+    targets = batch.auxiliary_numeric_targets[:, 1:]
+    error = (estimates - targets).pow(2)
+    if batch.auxiliary_numeric_target_masks is None:
+        weight = batch.valid_mask[:, 1:].unsqueeze(-1).expand_as(error).clone()
+    else:
+        weight = (
+            batch.valid_mask[:, 1:].unsqueeze(-1)
+            * batch.auxiliary_numeric_target_masks[:, 1:]
+        )
+    lineages = batch.metadata.get("lineage_family")
+    if lineages is None:
+        raise ValueError("masked auxiliary targets require lineage metadata")
+    if len(lineages) != error.size(0):
+        raise ValueError("lineage metadata does not align with auxiliary batch")
+    target_count = error.size(-1)
+    for target_index, prefixes in excluded_lineage_prefixes.items():
+        if not 0 <= target_index < target_count or not prefixes:
+            raise ValueError("masked auxiliary target contract is invalid")
+        for batch_index, sequence in enumerate(lineages):
+            if not sequence:
+                raise ValueError("lineage metadata sequence is empty")
+            if any(sequence[0].startswith(prefix) for prefix in prefixes):
+                weight[batch_index, :, target_index] = 0.0
+    # Preserve the historical all-head scale while excluding unobserved heads.
+    denominator = weight.sum().clamp_min(1.0)
+    return (error * weight).sum() * float(target_count) / denominator
+
