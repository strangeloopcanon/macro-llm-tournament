+    def state_sensitivity_loss(
+        self,
+        batch: StepBatch,
+        *,
+        forward_pass: ForwardPass,
+        counterfactual_state_latents: torch.Tensor,
+        margin: float,
+        target_index: int,
+        temperature: float,
+        target_difference_floor: float = 1e-8,
+        pair_weighting: str = "uniform",
+        counterfactual_targets: torch.Tensor | None = None,
