+    def consequence_ranking_loss(
+        self,
+        batch: StepBatch,
+        *,
+        forward_pass: ForwardPass,
+        target_index: int,
+        temperature: float,
+        target_difference_floor: float = 1e-8,
+        pair_weighting: str = "uniform",
+    ) -> torch.Tensor:
+        """Pairwise consequence-ranking supervision within one packed root."""
+
+        if self.auxiliary_head is None:
+            return forward_pass.total_loss.new_zeros(())
+        predictions = self.auxiliary_head(forward_pass.predicted_latents)
+        return self._consequence_ranking_error(
+            batch,
+            predictions=predictions,
+            target_index=target_index,
+            temperature=temperature,
+            target_difference_floor=target_difference_floor,
+            pair_weighting=pair_weighting,
+        )
+
+    def _consequence_ranking_error(
+        self,
+        batch: StepBatch,
+        *,
+        predictions: torch.Tensor,
+        target_index: int,
+        temperature: float,
+        target_difference_floor: float = 1e-8,
+        pair_weighting: str = "uniform",
+        target_values: torch.Tensor | None = None,
+        pair_mask: torch.Tensor | None = None,
+    ) -> torch.Tensor:
+        if self.auxiliary_head is None or batch.observation_numeric.size(0) < 2:
+            return predictions.new_zeros(())
+        if not 0 <= target_index < self.auxiliary_head.out_features:
+            raise ValueError("ranking target index is outside the auxiliary heads")
+        if temperature <= 0.0:
+            raise ValueError("ranking temperature must be positive")
+        if target_difference_floor < 0.0:
+            raise ValueError("ranking target difference floor cannot be negative")
+        if pair_weighting not in {"uniform", "utility_gap_above_floor"}:
+            raise ValueError("unsupported ranking pair weighting")
+        valid = self._choice_loss_mask(batch)[:, 0].bool()
+        targets = (
+            batch.auxiliary_numeric_targets[:, 1, target_index]
+            if target_values is None
+            else target_values
+        )[valid]
+        scores = predictions[:, 0, target_index][valid]
+        if targets.numel() < 2:
+            return predictions.new_zeros(())
+        target_delta = targets[:, None] - targets[None, :]
+        eligible_pairs = torch.triu(
+            target_delta.abs() > float(target_difference_floor), diagonal=1
+        )
+        if pair_mask is not None:
+            pair_mask = pair_mask.to(device=eligible_pairs.device, dtype=torch.bool)
+            pair_mask = pair_mask[valid][:, valid]
+            eligible_pairs = eligible_pairs & torch.triu(pair_mask, diagonal=1)
+        if not bool(eligible_pairs.any().item()):
+            return predictions.new_zeros(())
+        labels = (target_delta > 0.0).to(targets.dtype)
+        score_delta = scores[:, None] - scores[None, :]
+        losses = F.binary_cross_entropy_with_logits(
+            score_delta / float(temperature),
+            labels,
+            reduction="none",
+        )
+        selected_losses = losses[eligible_pairs]
+        if pair_weighting == "uniform":
+            return selected_losses.mean()
+        weights = (target_delta.abs() - float(target_difference_floor)).clamp_min(0.0)[
+            eligible_pairs
+        ]
+        return (selected_losses * weights).sum() / weights.sum().clamp_min(1e-12)
