+class PaperBalancedGroupedWindowBatchSampler:
+    """Oversample roots so every paper contributes the same root count per epoch."""
+
+    def __init__(
+        self,
+        dataset: WindowDataset,
+        *,
+        root_group_column: str,
+        paper_group_column: str,
+        batch_size: int,
+        seed: int,
+        shuffle: bool,
+    ) -> None:
+        for column in (root_group_column, paper_group_column):
+            if column not in dataset.frame.columns:
+                raise ValueError(f"paper-balanced sampler lacks {column}")
+        self._seed = seed
+        self._epoch = 0
+        self._shuffle = shuffle
+        self._roots: dict[str, list[int]] = {}
+        paper_by_root: dict[str, str] = {}
+        anchor_offset = dataset.schema.context_length - 1
+        for window_index, window in enumerate(dataset._windows):
+            anchor = window[min(anchor_offset, len(window) - 1)]
+            root = str(dataset.frame.at[anchor, root_group_column])
+            paper = str(dataset.frame.at[anchor, paper_group_column])
+            prior = paper_by_root.setdefault(root, paper)
+            if prior != paper:
+                raise ValueError("one packed root crosses paper families")
+            self._roots.setdefault(root, []).append(window_index)
+        if any(len(indices) > batch_size for indices in self._roots.values()):
+            raise ValueError("batch size must preserve each complete root menu")
+        self._roots_by_paper: dict[str, list[str]] = {}
+        for root, paper in paper_by_root.items():
+            self._roots_by_paper.setdefault(paper, []).append(root)
+        if not self._roots_by_paper:
+            raise ValueError("paper-balanced sampler found no papers")
+        self._roots_per_paper = max(map(len, self._roots_by_paper.values()))
+
+    def __iter__(self):
+        generator = torch.Generator()
+        generator.manual_seed(self._seed + self._epoch)
+        self._epoch += 1
+        batches: list[list[int]] = []
+        for paper in sorted(self._roots_by_paper):
+            roots = sorted(self._roots_by_paper[paper])
+            if self._shuffle:
+                order = torch.randperm(len(roots), generator=generator).tolist()
+                roots = [roots[index] for index in order]
+            selected = [
+                roots[index % len(roots)] for index in range(self._roots_per_paper)
+            ]
+            batches.extend([list(self._roots[root]) for root in selected])
+        if self._shuffle:
+            order = torch.randperm(len(batches), generator=generator).tolist()
+            batches = [batches[index] for index in order]
+        yield from batches
+
+    def __len__(self) -> int:
+        return len(self._roots_by_paper) * self._roots_per_paper
+
