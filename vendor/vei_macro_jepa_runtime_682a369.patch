+def _researchworld_counterfactual_supervision(
+    model: StructuredStateJEPA,
+    batch: StepBatch,
+    *,
+    root_id: str,
+    candidate_ids: tuple[str, ...],
+    donor_ids: Sequence[str],
+    donor_plan: StateSensitivityDonorPlan,
+    device: str,
+    zero_observation_inputs: bool = False,
+) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor, torch.Tensor]:
+    candidate_roles = donor_plan.root_candidate_roles[root_id]
+    try:
+        roles = tuple(candidate_roles[candidate_id] for candidate_id in candidate_ids)
+    except KeyError as exc:
+        raise ValueError(
+            "state-sensitivity batch candidate is absent from the donor plan"
+        ) from exc
+    current_utilities = donor_plan.root_role_utilities[root_id]
+    current = torch.tensor(
+        [current_utilities[role] for role in roles],
+        dtype=batch.auxiliary_numeric_targets.dtype,
+        device=batch.auxiliary_numeric_targets.device,
+    )
+    donor_latents: list[torch.Tensor] = []
+    donor_targets: list[torch.Tensor] = []
+    donor_pair_masks: list[torch.Tensor] = []
+    floor = float(donor_plan.target_difference_floor)
+    with torch.no_grad():
+        for donor_id in donor_ids:
+            donor_batch = collate_step_batches(
+                [donor_plan.representative_batches[donor_id]]
+            ).to(device)
+            if zero_observation_inputs:
+                donor_batch = _zero_observation_batch(donor_batch)
+            donor_latents.append(model.encode_steps(donor_batch).detach())
+            donor_utility_by_role = donor_plan.root_role_utilities[donor_id]
+            aligned = torch.tensor(
+                [donor_utility_by_role[role] for role in roles],
+                dtype=current.dtype,
+                device=current.device,
+            )
+            current_delta = current[:, None] - current[None, :]
+            donor_delta = aligned[:, None] - aligned[None, :]
+            meaningful_disagreement = (
+                (current_delta.abs() > floor)
+                & (donor_delta.abs() > floor)
+                & ((current_delta * donor_delta) < 0.0)
+            )
+            meaningful_disagreement = torch.triu(meaningful_disagreement, diagonal=1)
+            if not bool(meaningful_disagreement.any().item()):
+                raise ValueError(
+                    "state-sensitivity donor lacks a meaningful ordering disagreement"
+                )
+            donor_targets.append(aligned)
+            donor_pair_masks.append(meaningful_disagreement)
+    return (
+        torch.stack(donor_latents),
+        current,
+        torch.stack(donor_targets),
+        torch.stack(donor_pair_masks),
     )
 
 
